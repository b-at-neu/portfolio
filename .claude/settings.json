{
  "extraKnownMarketplaces": {
    "port": {
      "source": {
        "source": "git",
        "url": "https://github.com/b-at-neu/port.git"
      }
    }
  },
  "enabledPlugins": {
    "port@port": true
  },
  "permissions": {
    "allow": [
      "Bash(gh *)",
      "Bash(git *)",
      "Bash(npm *)",

      "Bash(grep)",
      "Bash(grep *)",
      "Bash(egrep)",
      "Bash(egrep *)",
      "Bash(rg)",
      "Bash(rg *)",
      "Bash(find)",
      "Bash(find *)",
      "Bash(ls)",
      "Bash(ls *)",
      "Bash(wc)",
      "Bash(wc *)",
      "Bash(sort)",
      "Bash(sort *)",
      "Bash(uniq)",
      "Bash(uniq *)",
      "Bash(stat)",
      "Bash(stat *)",
      "Bash(file)",
      "Bash(file *)",
      "Bash(pwd)",
      "Bash(pwd *)",
      "Bash(mkdir -p *)",

      "Edit(**)",
      "Write(**)",

      "WebFetch(domain:code.claude.com)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh issue delete *)",
      "Bash(gh repo delete *)",
      "Bash(gh auth *)",

      "Bash(git push * dev)",
      "Bash(git push origin dev)",
      "Bash(git push *:dev)",
      "Bash(git push * main)",
      "Bash(git push origin main)",
      "Bash(git push *:main)",

      "Bash(npm publish *)",
      "Bash(npm login *)",
      "Bash(npm adduser *)",

      "Bash(find * -exec *)",
      "Bash(find * -execdir *)",
      "Bash(find * -delete*)",
      "Bash(find * -ok *)",
      "Bash(find * -okdir *)",
      "Bash(find -exec *)",
      "Bash(find -execdir *)",
      "Bash(find -delete*)",
      "Bash(find -ok *)",
      "Bash(find -okdir *)"
    ]
  }
}
